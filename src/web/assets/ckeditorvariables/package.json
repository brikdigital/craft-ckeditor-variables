{
  "name": "@brikdigital/ckeditor5-variables",
  "version": "5.3.0",
  "description": "A plugin for CKEditor 5.",
  "keywords": [
    "ckeditor",
    "ckeditor5",
    "ckeditor 5",
    "ckeditor5-feature",
    "ckeditor5-plugin",
    "ckeditor5-package-generator"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*",
    "./browser/*": null,
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "dist",
    "ckeditor5-metadata.json"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "peerDependencies": {
    "@ckeditor/ckeditor5-core": ">=48.0.0 || ^0.0.0-nightly || ^0.0.0-internal",
    "ckeditor5": ">=48.0.0 || ^0.0.0-nightly || ^0.0.0-internal"
  },
  "devDependencies": {
    "@ckeditor/ckeditor5-core": "latest",
    "@ckeditor/ckeditor5-dev-build-tools": "61.2.0",
    "@ckeditor/ckeditor5-dev-translations": "61.2.0",
    "@ckeditor/ckeditor5-inspector": "^5.0.3",
    "@typescript-eslint/parser": "^8.60.0",
    "ckeditor5": "latest",
    "eslint": "^10.0.0",
    "eslint-config-ckeditor5": "^20.1.0",
    "eslint-plugin-ckeditor5-rules": "^20.1.0",
    "globals": "^16.1.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.6",
    "typescript": "7.0.2",
    "vite": "^8.1.2",
    "vite-plugin-svgo": "^2.0.0",
    "webdriverio": "^9.19.2"
  },
  "overrides": {
    "sugarss": "^5.0.1"
  },
  "scripts": {
    "start": "vite",
    "build": "pnpm run build:types && pnpm run build:npm && pnpm run build:browser",
    "build:npm": "vite build --mode npm",
    "build:browser": "vite build --mode browser",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --browser.headless=false",
    "lint": "eslint",
    "translations:synchronize": "node ./scripts/synchronize-translations.js",
    "translations:validate": "node ./scripts/synchronize-translations.js --validate-only",
    "prepublishOnly": "pnpm run build"
  },
  "lint-staged": {
    "**/*": [
      "eslint"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
